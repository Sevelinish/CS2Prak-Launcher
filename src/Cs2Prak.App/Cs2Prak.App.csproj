<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Cs2Prak.App</RootNamespace>
    <AssemblyName>cs2prak</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cs2Prak.Core\Cs2Prak.Core.csproj" />
    <ProjectReference Include="..\Cs2Prak.Server\Cs2Prak.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\static\**\*" LinkBase="static\" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\templates\**\*" LinkBase="templates\" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\maps\**\*" LinkBase="maps\" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.ico" LinkBase="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
